  "scripts": {
    "build:css": "npx tailwindcss -i assets/css/tailwind.css -o assets/css/material-tailwind.css --minify -c tailwind.config.cjs",
    "build:js": "npx rollup -c rollup.config.js",
    "build": "npm run build:css && npm run build:js"
  },
  "dependencies": {
    "firebase": "^12.14.0"
  },
  "devDependencies": {
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "rollup": "^4.62.2",
    "tailwindcss": "^3.4.10"
  }
}
